 or"], [144.28, 145.08, " hour,"], [145.32, 145.94, " but"], [145.94, 146.16, " the"], [146.16, 146.54, " sky"], [146.54, 147.14, " will"], [147.14, 147.8, " open"], [147.8, 148.54, " wide"]]}, {"start": 148.54, "end": 152.3, "text": "Every eye will see Him come", "words": [[148.54, 149.86, " Every"], [149.86, 150.52, " eye"], [150.52, 150.82, " will"], [150.82, 151.22, " see"], [151.22, 151.72, " Him"], [151.72, 152.3, " come"]]}, {"start": 153.0, "end": 156.9, "text": "The King returns for his bride", "words": [[152.72, 153.14, " The"], [153.14, 153.42, " King"], [153.42, 154.04, " returns"], [154.04, 154.98, " for"], [154.98, 155.46, " his"], [155.46, 156.9, " bride"]]}, {"start": 156.9, "end": 161.16, "text": "From the garden to the throne", "words": [[156.9, 158.92, " From"], [158.92, 159.12, " the"], [159.12, 159.74, " garden"], [159.74, 160.44, " to"], [160.44, 160.72, " the"], [160.72, 161.16, " throne"]]}, {"start": 161.16, "end": 165.06, "text": "Every nation, every shore", "words": [[161.16, 162.7, " Every"], [162.7, 163.46, " nation,"], [163.86, 164.36, " every"], [164.36, 165.06, " shore"]]}, {"start": 165.06, "end": 168.74, "text": "One name carried through the years", "words": [[165.06, 165.94, " One"], [165.94, 166.34, " name"], [166.34, 167.08, " carried"], [167.08, 167.74, " through"], [167.74, 168.1, " the"], [168.1, 168.74, " years"]]}, {"start": 168.74, "end": 174.56, "text": "Jesus, King, forevermore", "words": [[168.74, 169.8, " Jesus,"], [170.22, 170.94, " King,"], [171.36, 174.56, " forevermore"]]}, {"start": 176.86, "end": 180.76, "text": "Come Lord Jesus", "words": [[176.86, 178.26, " Come"], [178.26, 179.14, " Lord"], [179.14, 180.76, " Jesus"]]}, {"start": 184.56, "end": 188.62, "text": "Come Lord Jesus", "words": [[184.56, 185.34, " Come"], [185.34, 186.56, " Lord"], [186.56, 188.62, " Jesus"]]}]