[{"start": 30.0, "end": 40.88, "text": "up at stars. Moses split the sea in two. David sang, the prophets cried, a king is coming.", "words": [[30.0, 30.32, " up"], [30.32, 30.6, " at"], [30.6, 31.36, " stars."], [31.9, 32.82, " Moses"], [32.82, 33.24, " split"], [33.24, 33.68, " the"], [33.68, 34.22, " sea"], [34.22, 34.68, " in"], [34.68, 35.18, " two."], [35.7, 36.38, " David"], [36.38, 37.22, " sang,"], [37.5, 37.6, " the"], [37.6, 38.04, " prophets"], [38.04, 38.7, " cried,"], [39.36, 39.5, " a"], [39.5, 39.94, " king"], [39.94, 40.4, " is"], [40.4, 40.88, " coming."]]}, {"start": 41.28, "end": 54.28, "text": "Wait for him. From the garden to the cross. From the cross to every shore. One name carried", "words": [[41.28, 41.74, " Wait"], [41.74, 42.24, " for"], [42.24, 43.88, " him."], [45.54, 45.9, " From"], [45.9, 46.1, " the"], [46.1, 46.74, " garden"], [46.74, 47.46, " to"], [47.46, 47.84, " the"], [47.84, 48.22, " cross."], [49.0, 49.64, " From"], [49.64, 49.84, " the"], [49.84, 50.26, " cross"], [50.26, 50.62, " to"], [50.62, 51.48, " every"], [51.48, 52.18, " shore."], [52.74, 53.14, " One"], [53.14, 53.56, " name"], [53.56, 54.28, " carried"]]}, {"start": 54.28, "end": 60.26, "text": "through the years. Jesus, now and evermore.", "words": [[54.28, 54.92, " through"], [54.92, 55.32, " the"], [55.32, 56.02, " years."], [56.46, 57.02, " Jesus,"], [57.38, 57.9, " now"], [57.9, 58.44, " and"], [58.44, 60.26, " evermore."]]}, {"start": 66.6, "end": 72.22, "text": "The heaven, the child is born. Heaven sings above the hay. He'll be blind and come the storm.", "words": [[66.6, 67.16, " The"], [67.16, 67.42, " heaven,"], [67.48, 67.62, " the"], [67.62, 67.92, " child"], [67.92, 68.14, " is"], [68.14, 68.42, " born."], [68.7, 68.86, " Heaven"], [68.86, 69.16, " sings"], [69.16, 69.72, " above"], [69.72, 70.02, " the"], [70.02, 70.34, " hay."], [70.6, 70.74, " He'll"], [70.74, 70.84, " be"], [70.84, 71.16, " blind"], [71.16, 71.42, " and"], [71.42, 71.62, " come"], [71.62, 71.86, " the"], [71.86, 72.22, " storm."]]}, {"start": 72.38, "end": 77.8, "text": "Then the cross, the darkest day. Three days on the stone was rolled. Death itself could not hold on.", "words": [[72.38, 72.6, " Then"], [72.6, 72.76, " the"], [72.76, 72.94, " cross,"], [73.18, 73.26, " the"], [73.26, 73.62, " darkest"], [73.62, 74.04, " day."], [74.22, 74.4, " Three"], [74.4, 74.64, " days"], [74.64, 74.92, " on"], [74.92, 75.08, " the"], [75.08, 75.34, " stone"], [75.34, 75.56, " was"], [75.56, 75.88, " rolled."], [76.32, 76.32, " Death"], [76.32, 76.74, " itself"], [76.74, 76.9, " could"], [76.9, 77.18, " not"], [77.18, 77.46, " hold"], [77.46, 77.8, " on."]]}, {"start": 77.8, "end": 87.32, "text": "Go to all the world. He said, and the fire fell on them. From the garden to the cross.", "words": [[77.8, 78.16, " Go"], [78.16, 78.3, " to"], [78.3, 78.64, " all"], [78.64, 78.8, " the"], [78.8, 79.12, " world."], [79.18, 79.26, " He"], [79.26, 79.48, " said,"], [79.58, 79.6, " and"], [79.6, 79.7, " the"], [79.7, 80.18, " fire"], [80.18, 81.06, " fell"], [81.06, 81.66, " on"], [81.66, 82.66, " them."], [84.54, 85.12, " From"], [85.12, 85.3, " the"], [85.3, 85.92, " garden"], [85.92, 86.58, " to"], [86.58, 87.0, " the"], [87.0, 87.32, " cross."]]}, {"start": 87.96, "end": 98.9, "text": "From the cross to every shore. One name carried through the years. Jesus, now and evermore.", "words": [[87.96, 88.8, " From"], [88.8, 89.0, " the"], [89.0, 89.42, " cross"], [89.42, 89.86, " to"], [89.86, 90.58, " every"], [90.58, 91.3, " shore."], [91.94, 92.26, " One"], [92.26, 92.64, " name"], [92.64, 93.32, " carried"], [93.32, 94.04, " through"], [94.04, 94.4, " the"], [94.4, 95.06, " years."], [95.38, 96.1, " Jesus,"], [96.48, 96.98, " now"], [96.98, 97.46, " and"], [97.46, 98.9, " evermore."]]}, {"start": 108.88, "end": 111.5, "text": "Oh, oh, oh, oh.", "words": [[108.88, 109.76, " Oh,"], [109.78, 109.78, " oh,"], [109.94, 110.64, " oh,"], [110.72, 111.5, " oh."]]}, {"