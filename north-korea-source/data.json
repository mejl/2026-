9, "b": 8.7, "s": "My name is Yekutiel Zelig Finkelkrantz.", "k": "say", "d": 2.6, "wt": [4.02, 4.42, 4.6, 4.74, 5.41, 6.08]}, {"a": 9.37, "b": 13.3, "s": "I went to North Korea", "k": "say", "d": 1.4, "wt": [9.4, 9.8, 9.98, 10.2, 10.44]}, {"a": 13.63, "b": 15.9, "s": "for 7 days.", "k": "say", "d": 0.8, "wt": [13.66, 13.72, 14.07]}, {"a": 16.39, "b": 19.0, "s": "The first 2 were very nice.", "k": "say", "d": 1.6, "wt": [16.42, 16.82, 17.1, 18.06, 18.46, 18.75]}, {"a": 133.35, "b": 135.7, "s": "Friday evening.", "k": "say", "d": 0.8, "wt": [133.38, 133.86]}, {"a": 136.02, "b": 138.8, "s": "They told me I was not under arrest.", "k": "say", "d": 1.5, "wt": [136.05, 136.45, 136.65, 136.83, 136.95, 137.09, 137.31, 137.65]}, {"a": 139.14, "b": 140.15, "s": "I said: \"Excellent.\"", "k": "say", "d": 0.8, "wt": [139.17, 139.57, 139.9]}, {"a": 141.66, "b": 143.8, "s": "They said I was not allowed to leave.", "k": "say", "d": 2.6, "wt": [141.69, 142.09, 142.25, 142.39, 142.51, 142.69, 142.93, 143.15]}, {"a": 144.12, "b": 146.4, "s": "I said: \"Less excellent.\"", "k": "say", "d": 1.3, "wt": [144.15, 144.55, 145.13, 145.55]}, {"a": 188.01, "b": 190.6, "s": "I finally arrived in Israel.", "k": "say", "d": 3.2, "wt": [188.04, 188.3, 188.56, 188.82, 189.08]}, {"a": 191.93, "b": 193.9, "s": "I went to a restaurant.", "k": "say", "d": 0.9, "wt": [191.96, 192.04, 192.18, 192.36, 192.54]}, {"a": 194.17, "b": 199.6, "s": "I asked for something kosher.", "k": "say", "d": 1.6, "wt": [194.2, 194.52, 194.84, 195.16, 195.48]}, {"a": 199.83, "b": 202.1, "s": "The waiter brought me a sandwich.", "k": "say", "d": 1.1, "wt": [199.86, 199.92, 200.13, 200.43, 200.63, 200.89]}, {"a": 202.48, "b": 205.6, "s": "No questions.", "k": "say", "d": 0.8, "wt": [202.51, 202.99]}, {"a": 205.9, "b": 207.3, "s": "No investigation.", "k": "say", "d": 0.7, "wt": [205.93, 206.43]}, {"a": 208.48, "b": 210.1, "s": "Just a sandwich.", "k": "say", "d": 1.2, "wt": [208.51, 208.77, 209.03]}, {"a": 210.37, "b": 212.7, "s": "Very nice.", "k": "say", "d": 0.7, "wt": [210.4, 210.75]}, {"a": 30.91, "b": 31.830000000000002, "s": "Monday in Pyongyang,", "k": "sub", "wt": [30.94, 31.2, 31.44]}, {"a": 32.27, "b": 33.550000000000004, "s": "everything was fine.", "k": "sub", "wt": [32.3, 32.72, 33.12]}, {"a": 33.61, "b": 34.69, "s": "Tuesday at the museum,", "k": "sub", "wt": [33.64, 33.8, 34.16, 34.38]}, {"a": 34.97, "b": 36.93, "s": "standing in a line.", "k": "sub", "wt": [35.0, 35.4, 35.76, 36.02]}, {"a": 36.99, "b": 38.65, "s": "Wednesday at the restaurant,", "k": "sub", "wt": [37.02, 37.38, 37.72, 37.98]}, {"a": 38.71, "b": 40.03, "s": "chicken on the plate.", "k": "sub", "wt": [38.74, 38.94, 39.28, 39.44]}, {"a": 40.09, "b": 41.550000000000004, "s": "I asked for something kosher,", "k": "sub", "wt": [40.12, 40.26, 40.48, 40.64, 41.04]}, {"a": 42.85, "b": 43.13, "s": "then everybody wait.", "k": "sub", "wt": [42.88, 42.88, 42.88]}, {"a": 43.19, "b": 46.050000000000004, "s": "The waiter stopped writing.", "k": "sub", "wt": [43.22, 43.49, 43.76, 44.02]}, {"a": 46.39, "b": 49.36, "s": "Mister Kim stopped too.", "k": "sub", "wt": [46.42, 46.68, 46.78, 47.22]}, {"a": 49.5, "b": 52.0, "s": "I said I'm Jewish.", "k": "sub", "wt": [49.53, 49.93, 50.27, 51.05]}, {"a": 52.08, "b": 54.86, "s": "He put down his spoon.", "k": "sub", "wt": [52.11, 52.51, 52.85, 53.25, 53.61]}, {"a": 80.97, "b": 82.63, "s": "Thursday at the office,", "k": "sub", "wt": [81.0, 81.24, 81.49, 81.73]}, {"a": 82.77, "b": 83.89, "s": "questions all day long.", "k": "sub", "wt": [82.8, 83.2, 83.58, 83.64]}, {"a": 83.95, "b": 85.58999999999999, "s": "They asked me who had sent me,", "k": "sub", "wt": [83.98, 84.18, 84.36, 84.54, 84.82, 85.12, 85.34]}, {"a": 85.61, "b": 86.91, "s": "then said nothing was wrong.", "k": "sub", "wt": [85.64, 85.9, 86.08, 86.36, 86.66]}, {"a": 86.97, "b": 88.66999999999999, "s": "They took away my passport,", "k": "sub", "wt": [87.0, 87.3, 87.52, 87.88, 88.36]}, {"a": 88.85, "b": 90.36, "s": 