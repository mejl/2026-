.8, "text": "What kind of love would bleed for me?", "hook": false}, {"a": 74.7, "b": 77.5, "text": "Still You stayed", "hook": true}, {"a": 86.4, "b": 91.5, "text": "Thirty silver for a kiss", "hook": false}, {"a": 93.1, "b": 96.9, "text": "Three denials, a clenched fist", "hook": false}, {"a": 97.7, "b": 102.4, "text": "All Your friends ran in the night", "hook": false}, {"a": 103.4, "b": 108.6, "text": "You looked at them with love, not spite", "hook": false}, {"a": 109.7, "b": 112.6, "text": "Father, forgive, I heard You say", "hook": false}, {"a": 112.8, "b": 119.9, "text": "They don't know, they don't know", "hook": false}, {"a": 122.4, "b": 128.0, "text": "Still You stayed, still You stayed", "hook": true}, {"a": 128.4, "b": 134.0, "text": "Arms wide open in the pain", "hook": false}, {"a": 134.3, "b": 137.3, "text": "I was the reason for the scars", "hook": false}, {"a": 137.6, "b": 140.3, "text": "Still You called me from the dark", "hook": false}, {"a": 140.6, "b": 146.8, "text": "What kind of love would bleed for me?", "hook": false}, {"a": 147.6, "b": 149.5, "text": "Still You stayed", "hook": true}, {"a": 149.8, "b": 152.1, "text": "Not death, not life", "hook": false}, {"a": 152.3, "b": 155.0, "text": "Not depth, not height", "hook": false}, {"a": 155.2, "b": 157.8, "text": "Nothing tears me from Your side", "hook": false}, {"a": 158.0, "b": 162.6, "text": "The stone is rolled, the grave is bare", "hook": false}, {"a": 163.5, "b": 169.2, "text": "I ran from You, and You were there", "hook": false}, {"a": 171.1, "b": 176.9, "text": "Still You stay, still You stay", "hook": true}, {"a": 177.2, "b": 182.5, "text": "Every tear You wipe away", "hook": false}, {"a": 182.8, "b": 185.7, "text": "Scarlet sins made white as snow", "hook": false}, {"a": 185.9, "b": 189.0, "text": "Love that will not let me go", "hook": false}, {"a": 189.2, "b": 195.6, "text": "What kind of love would die for me?", "hook": false}, {"a": 196.2, "b": 199.5, "text": "Still You stay", "hook": true}], "total": 219.16}